{
  "name": "llama-cpp-studio",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Standalone local application for llama.cpp: install official builds, manage GGUF models and their launch flags, run llama-server and use its OpenAI-compatible API. Zero npm dependencies — built from the DeepSeek Harness llama.cpp plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/amahasin/llama-cpp-studio.git"
  },
  "homepage": "https://github.com/amahasin/llama-cpp-studio#readme",
  "bugs": {
    "url": "https://github.com/amahasin/llama-cpp-studio/issues"
  },
  "bin": {
    "llama-studio": "src/main.js"
  },
  "main": "src/main.js",
  "scripts": {
    "build": "node build.js",
    "start": "node src/main.js",
    "status": "node src/main.js --status",
    "test": "node tests/run-all.js",
    "test:units": "node tests/units.test.js",
    "lint": "npx --yes eslint .",
    "patch-ui": "node tools/patch-client-bundle.js",
    "release": "node installer/build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ]
}
